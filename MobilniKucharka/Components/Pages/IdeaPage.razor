@page "/idea"
@namespace MobilniKucharka.Components.Pages
@inject IDialogService DialogService

<div class="create-recipe-page">
    <div class="create-recipe-header">
        <button type="button" class="icon-btn" @onclick="NavigateBackAsync">←</button>
    </div>

    <div class="create-recipe-body">
        <h1 class="hub-title" style="font-size:22px; margin:0 0 4px 0;">@Tr("Navrhnout vylepšení")</h1>
        <p style="margin:0; color:var(--color-text-secondary); font-size:13px;">
            @Tr("Máš nápad, co by appka měla umět? Napiš mi to sem.")
        </p>

        <div class="form-group">
            <label class="form-label">@Tr("Název nápadu")</label>
            <input type="text" class="form-input" placeholder="@Tr("Např. Nákupní seznam")"
                   value="@_title" disabled="@_isSending"
                   @oninput="(e) => _title = e.Value?.ToString() ?? string.Empty" />
        </div>

        <div class="form-group">
            <label class="form-label">@Tr("Popis nápadu")</label>
            <textarea class="form-textarea" style="min-height:110px;" placeholder="@Tr("Popiš svůj nápad co nejpřesněji...")"
                      value="@_description" disabled="@_isSending"
                      @oninput="(e) => _description = e.Value?.ToString() ?? string.Empty"></textarea>
        </div>

        <button type="button" class="btn-action btn-success" style="height:55px; margin-top:6px;" @onclick="OnSendInAppAsync" disabled="@_isSending">
            @if (_isSending)
            {
                <span>⏳ @Tr("Odesílám...")</span>
            }
            else
            {
                <span>@Tr("Odeslat")</span>
            }
        </button>

        <button type="button" class="recipe-source-link" @onclick="OnSendByEmailAsync" disabled="@_isSending">
            @Tr("Nebo odeslat e-mailem")
        </button>
    </div>
</div>

@code {
    private const string DeveloperEmail = "devzoufaly@gmail.com";

    private string _title = string.Empty;
    private string _description = string.Empty;
    private bool _isSending = false;

    private static string Tr(string csText) => UiTranslator.Tr(csText);

    private string BuildIdeaText()
    {
        string titlePart = string.IsNullOrWhiteSpace(_title) ? "(bez názvu)" : _title;
        string descriptionPart = string.IsNullOrWhiteSpace(_description) ? "(nevyplněno)" : _description;

        return $"**Zdroj:** Nápady na vylepšení\n\n" +
               $"**{titlePart}**\n\n" +
               $"{descriptionPart}";
    }

    private async Task<bool> ValidateAsync()
    {
        if (string.IsNullOrWhiteSpace(_description))
        {
            await DialogService.ShowAlertAsync(Tr("Upozornění"), Tr("Zadej prosím popis nápadu."), "OK");
            return false;
        }
        return true;
    }

    private async Task OnSendInAppAsync()
    {
        if (!await ValidateAsync()) return;

        _isSending = true;
        try
        {
            var service = new GitHubDiscussionService();
            var result = await service.PostCommentAsync(GitHubDiscussionService.IdeaDiscussionNumber, BuildIdeaText());

            if (result == DiscussionPostResult.Success)
            {
                await DialogService.ShowAlertAsync(Tr("Odesláno"), Tr("Díky za nápad!"), "OK");
                await NavigateBackAsync();
            }
            else if (result == DiscussionPostResult.NotConfigured)
            {
                await DialogService.ShowAlertAsync(
                    Tr("Odeslání není nastavené"),
                    Tr("Odeslání přímo z aplikace teď není k dispozici. Použij prosím odeslání e-mailem níže."),
                    "OK");
            }
            else
            {
                await DialogService.ShowAlertAsync(
                    Tr("Odeslání se nepodařilo"),
                    Tr("Zkontroluj internetové připojení a zkus to znovu, nebo použij odeslání e-mailem níže."),
                    "OK");
            }
        }
        finally
        {
            _isSending = false;
        }
    }

    private async Task OnSendByEmailAsync()
    {
        if (!await ValidateAsync()) return;

        try
        {
            await Email.Default.ComposeAsync(new EmailMessage
            {
                Subject = string.IsNullOrWhiteSpace(_title) ? Tr("Nápad na vylepšení - Mobilní Kuchařka") : $"{Tr("Nápad na vylepšení")}: {_title}",
                Body = BuildIdeaText(),
                To = [DeveloperEmail]
            });
        }
        catch (FeatureNotSupportedException)
        {
            await DialogService.ShowAlertAsync(Tr("Chyba"), Tr("Na tomto zařízení není nastavená žádná e-mailová aplikace."), "OK");
        }
        catch (Exception ex)
        {
            await DialogService.ShowAlertAsync(Tr("Chyba"), ex.Message, "OK");
        }
    }

    private async Task NavigateBackAsync()
    {
        var nav = Application.Current?.Windows.FirstOrDefault()?.Page?.Navigation;
        if (nav != null)
        {
            await nav.PopAsync();
        }
    }
}