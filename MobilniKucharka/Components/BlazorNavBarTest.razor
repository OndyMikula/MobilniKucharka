@namespace MobilniKucharka.Components

<div class="test-page">
    <div class="test-content">
        <h2>@ActiveTabLabel</h2>
        <p>Zkušební stránka - klepni na tlačítka dole a sleduj, jak modrá "pilulka" plyne mezi nimi. Skutečná navigace zatím nikam nevede.</p>
    </div>

    <BottomNavBar ActiveTab="_activeTab" TabRequested="OnTabRequested" />
</div>

@code {
    private AppTab _activeTab = AppTab.Recipes;

    private string ActiveTabLabel => _activeTab switch
    {
        AppTab.Recipes => "📖 Recepty",
        AppTab.Search => "🔍 Hledat",
        AppTab.Bookmarks => "🔖 Záložky",
        _ => ""
    };

    private void OnTabRequested(AppTab tab)
    {
        _activeTab = tab;
    }
}