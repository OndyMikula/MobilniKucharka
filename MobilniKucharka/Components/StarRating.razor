@namespace MobilniKucharka.Components

<div class="star-rating" style="--star-size: @(SizePx)px;">
    @for (int i = 0; i < 5; i++)
    {
        int starIndex = i;
        double fillAmount = GetFillAmount(starIndex);

        <span class="star-slot">
            <span class="star star-empty">★</span>
            <span class="star star-filled" style="clip-path: inset(0 @(100 - fillAmount)% 0 0);">★</span>

            @if (Interactive)
            {
                <span class="star-hit-left" @onclick="() => OnStarTapped(starIndex, half: true)" @onclick:stopPropagation="true"></span>
                <span class="star-hit-right" @onclick="() => OnStarTapped(starIndex, half: false)" @onclick:stopPropagation="true"></span>
            }
        </span>
    }
</div>

@code {
    [Parameter] public double Rating { get; set; }
    [Parameter] public bool Interactive { get; set; } = false;
    [Parameter] public int SizePx { get; set; } = 24;
    [Parameter] public EventCallback<double> RatingChanged { get; set; }

    // Přímý přepis StarRatingHelper.BuildStarVisual/BuildHalfStar (XAML verze) - stejné
    // prahové hodnoty (>= 0.25 pro půlku, >= 0.75 zaokrouhlí nahoru na celou), jen vrací
    // procento vyplnění místo skládání Label/Grid vizuálu ručně.
    private double GetFillAmount(int index)
    {
        int fullStars = (int)Math.Floor(Rating);
        double remainder = Rating - fullStars;
        bool hasHalfStar = remainder >= 0.25 && remainder < 0.75;
        if (remainder >= 0.75) fullStars++;

        if (index < fullStars) return 100;
        if (index == fullStars && hasHalfStar) return 50;
        return 0;
    }

    private async Task OnStarTapped(int index, bool half)
    {
        if (!Interactive) return;
        double newRating = index + (half ? 0.5 : 1.0);
        Rating = newRating;
        await RatingChanged.InvokeAsync(newRating);
    }
}