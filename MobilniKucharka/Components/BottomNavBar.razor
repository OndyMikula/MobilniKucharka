@namespace MobilniKucharka.Components
@inject NavigationManager NavigationManager

<div class="nav-bar">
    <div class="nav-pill" style="@PillStyle"></div>

    <button type="button" class="nav-button @(ActiveTab == AppTab.Recipes ? "active" : "")" @onclick="() => SelectTab(AppTab.Recipes)">
        @Tr("Recepty")
    </button>
    <button type="button" class="nav-button @(ActiveTab == AppTab.Search ? "active" : "")" @onclick="() => SelectTab(AppTab.Search)">
        @Tr("Hledat")
    </button>
    <button type="button" class="nav-button @(ActiveTab == AppTab.Bookmarks ? "active" : "")" @onclick="() => SelectTab(AppTab.Bookmarks)">
        @Tr("Záložky")
    </button>
</div>

@code {
    [Parameter] public AppTab ActiveTab { get; set; } = AppTab.Recipes;
    [Parameter] public EventCallback<AppTab> ActiveTabChanged { get; set; }

    private static string Tr(string csText) => UiTranslator.Tr(csText);

    private string PillStyle => $"transform: translateX({(int)ActiveTab * 100}%);";

    private async Task SelectTab(AppTab tab)
    {
        if (tab == ActiveTab) return;

        ActiveTab = tab;
        await ActiveTabChanged.InvokeAsync(tab);

        string route = tab switch
        {
            AppTab.Recipes => "/",
            AppTab.Search => "/search",
            AppTab.Bookmarks => "/bookmarks",
            _ => "/"
        };

        NavigationManager.NavigateTo(route);
    }
}