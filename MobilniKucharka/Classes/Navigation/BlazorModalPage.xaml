<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MobilniKucharka.Components"
             x:Class="MobilniKucharka.Classes.Navigation.BlazorModalPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <BlazorWebView x:Name="BlazorWebViewControl" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:ModalEntry}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>