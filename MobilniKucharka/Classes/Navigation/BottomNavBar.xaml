<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MobilniKucharka.Translation"
             x:Class="MobilniKucharka.Classes.Navigation.BottomNavBar">

    <Grid x:Name="RootGrid" ColumnDefinitions="*,*,*"
      Padding="10,10,10,20" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#1F1F1F}"
      SizeChanged="OnRootGridSizeChanged">

        <!-- Modrá "pilulka" - vykreslena jako první (nejníž v z-order), takže tlačítka nad ní
             s průhledným pozadím zůstávají klikatelná a čitelná. Skutečná šířka/pozice se dopočítá
             za běhu podle šířky gridu (viz OnRootGridSizeChanged v code-behind); WidthRequest tady
             je jen bezpečný počáteční odhad, než layout doběhne poprvé. Přesun mezi záložkami jde
             přes TranslationX (viz AnimateToActiveTab). -->
        <Border x:Name="IndicatorPill" Grid.Column="0" Grid.ColumnSpan="3"
                HorizontalOptions="Start" VerticalOptions="Fill" WidthRequest="90"
                BackgroundColor="#2196F3" Stroke="Transparent"
                StrokeShape="RoundRectangle 10" Margin="5,0,5,10" />

        <Button Grid.Column="0" x:Name="RecipesButton" Text="{loc:Tr 'Recepty'}" Clicked="OnRecipesTapped"
                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}"
                FontAttributes="Bold" CornerRadius="10" Margin="5,0,5,10" />
        <Button Grid.Column="1" x:Name="SearchButton" Text="{loc:Tr 'Hledat'}" Clicked="OnSearchTapped"
                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}"
                FontAttributes="Bold" CornerRadius="10" Margin="5,0,5,10" />
        <Button Grid.Column="2" x:Name="BookmarksButton" Text="{loc:Tr 'Záložky'}" Clicked="OnBookmarksTapped"
                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}"
                FontAttributes="Bold" CornerRadius="10" Margin="5,0,5,10" />
    </Grid>
</ContentView>