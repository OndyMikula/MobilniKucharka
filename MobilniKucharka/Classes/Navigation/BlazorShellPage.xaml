<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MobilniKucharka.Components"
             x:Class="MobilniKucharka.Classes.Navigation.BlazorShellPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*, Auto">

        <BlazorWebView Grid.Row="0" x:Name="BlazorWebViewControl" HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>

        <!-- Vyplní přesně tolik prostoru, kolik zabírá systémová navigační lišta (viz
             MainActivity.SystemBottomInsetChanged), stejnou barvou jako appčin vlastní spodní
             nav bar (BottomNavBar.razor / -color-nav-bg v app.css) - appka tak nikdy neleží pod
             systémovými tlačítky zpět/domů/přehled aplikací. Výška 0 na zařízeních/OS verzích,
             kde k překryvu vůbec nedochází. -->
        <BoxView Grid.Row="1" x:Name="SystemNavInsetSpacer" HeightRequest="0"
                 Color="{AppThemeBinding Light=#E0E0E0, Dark=#1F1F1F}" />

    </Grid>

</ContentPage>