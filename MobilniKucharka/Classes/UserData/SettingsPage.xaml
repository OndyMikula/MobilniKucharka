<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MobilniKucharka.Translation"
             x:Class="MobilniKucharka.SettingsPage"
             Title="{loc:Tr 'Nastavení'}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="..." Clicked="OnDeveloperToggleClicked" />
    </ContentPage.ToolbarItems>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="25">

                <!-- VZHLED A TÉMA APLIKACE -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Tr 'Vzhled aplikace'}" FontAttributes="Bold" FontSize="16"/>
                    <Picker x:Name="ThemePicker" SelectedIndexChanged="OnThemeChanged" />
                </VerticalStackLayout>

                <!-- JAZYK APLIKACE -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Tr 'Jazyk aplikace'}" FontAttributes="Bold" FontSize="16"/>
                    <Picker x:Name="LanguagePicker" Title="{loc:Tr 'Vyber jazyk'}" SelectedIndexChanged="OnLanguageChanged">
                        <Picker.Items>
                            <x:String>Čeština</x:String>
                            <x:String>English</x:String>
                        </Picker.Items>
                    </Picker>
                    <Label Text="{loc:Tr 'Změna jazyka se projeví po restartu aplikace.'}" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>

                <!-- BETA PROGRAM: NEZAREGISTROVANÝ (produkční build) -->
                <VerticalStackLayout x:Name="BetaOptInSection" Spacing="10" Margin="0,20,0,0" IsVisible="False">
                    <Label Text="{loc:Tr 'Beta program'}" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="{loc:Tr 'Připoj se do beta programu a dostávej nové verze dřív, ještě před oficiálním vydáním. Beta verze mohou obsahovat chyby.'}" FontSize="12" TextColor="Gray"/>
                    <Label Text="{loc:Tr 'Kód beta programu:'}" FontAttributes="Bold" FontSize="14"/>
                    <Entry x:Name="BetaCodeEntry" Placeholder="{loc:Tr 'Zadej kód'}" />
                    <Button Text="{loc:Tr 'Připojit se'}" Clicked="OnRegisterBetaClicked" BackgroundColor="#9C27B0" TextColor="White" CornerRadius="10"/>
                </VerticalStackLayout>

                <!-- BETA PROGRAM: JIŽ ZAREGISTROVANÝ -->
                <VerticalStackLayout x:Name="BetaOptedInSection" Spacing="10" Margin="0,20,0,0" IsVisible="False">
                    <Label Text="{loc:Tr 'Beta program'}" FontSize="18" FontAttributes="Bold"/>
                    <Label x:Name="BetaOptedInStatusLabel" FontSize="12" TextColor="Green"/>
                    <Button x:Name="UnregisterBetaButton" Text="{loc:Tr 'Odhlásit se z beta programu'}" Clicked="OnUnregisterBetaClicked" BackgroundColor="Gray" TextColor="White" CornerRadius="10"/>
                </VerticalStackLayout>

                <!-- IMPORT RECEPTU ZE SOUBORU -->
                <VerticalStackLayout Spacing="10" Margin="0,20,0,0">
                    <Label Text="{loc:Tr 'Sdílet recepty'}" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="{loc:Tr 'Vloží recept, který ti poslal někdo jiný ze svého zařízení.'}" FontSize="12" TextColor="Gray"/>
                    <Button Text="{loc:Tr 'Načíst recept ze souboru'}" Clicked="OnImportRecipeClicked" BackgroundColor="#9C27B0" TextColor="White" CornerRadius="10"/>
                    <Label Text="{loc:Tr 'Nebo vlož odkaz na sdílený recept:'}" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" x:Name="RecipeLinkEntry" Placeholder="{loc:Tr 'Vlož odkaz sem'}" />
                        <Button Grid.Column="1" Text="{loc:Tr 'Importovat'}" Clicked="OnImportFromLinkClicked" BackgroundColor="#9C27B0" TextColor="White" CornerRadius="10"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- ZÁLOHA DAT -->
                <VerticalStackLayout Spacing="10" Margin="0,20,0,0">
                    <Label Text="{loc:Tr 'Záloha dat'}" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="{loc:Tr 'Exportuje všechny recepty, záložky a nastavení do jednoho souboru, který můžeš přenést na jiné zařízení.'}" FontSize="12" TextColor="Gray"/>
                    <Button Text="{loc:Tr 'Exportovat data'}" Clicked="OnExportDataClicked" BackgroundColor="#2196F3" TextColor="White" CornerRadius="10"/>
                    <Button Text="{loc:Tr 'Uložit zálohu do zařízení'}" Clicked="OnSaveDataToDeviceClicked" BackgroundColor="#607D8B" TextColor="White" CornerRadius="10"/>
                    <Button Text="{loc:Tr 'Načíst data ze zálohy'}" Clicked="OnLoadDataClicked" BackgroundColor="#FF9800" TextColor="White" CornerRadius="10"/>
                </VerticalStackLayout>

                <!-- VYHLEDAT AKTUALIZACE -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Tr 'Vyhledat aktualizace'}" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="{loc:Tr 'Vyhledá nejnovější dostupnou verzi a porovná ji s nainstalovanou verzí.'}" FontSize="12" TextColor="Gray"/>
                    <Button Text="{loc:Tr 'Vyhledat aktualizace'}" Clicked="OnCheckForUpdatesClicked" BackgroundColor="#2196F3" TextColor="White" CornerRadius="10"/>
                </VerticalStackLayout>

                <!-- NAHLASIT CHYBU -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Tr 'Nahlásit chybu'}" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="{loc:Tr 'Pošli hlášení o chybě přímo vývojáři - stačí popsat, co se stalo.'}" FontSize="12" TextColor="Gray"/>
                    <Button Text="{loc:Tr 'Nahlásit chybu'}" Clicked="OnReportBugClicked" BackgroundColor="#9C27B0" TextColor="White" CornerRadius="10"/>
                </VerticalStackLayout>

                <Grid x:Name="BackupProgressOverlay" IsVisible="False" BackgroundColor="#99000000">
                    <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="280" Padding="25" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" StrokeShape="RoundRectangle 15">
                        <VerticalStackLayout Spacing="15">
                            <Label x:Name="BackupProgressLabel" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <ProgressBar x:Name="BackupProgressBar" Progress="0" ProgressColor="#2196F3"/>
                            <Label x:Name="BackupProgressPercentLabel" Text="0 %" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- PRÁVNÍ INFORMACE - jeden odkaz, klepnutím nabídne ToS/Privacy/License/Third-Party
        Notices přes action sheet (viz OnLegalInfoTapped). -->
                <Label Text="{loc:Tr 'Právní informace'}" FontSize="13" TextColor="#2196F3" TextDecorations="Underline" HorizontalOptions="Center" Opacity="0.8" Margin="0,0,0,20">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLegalInfoTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- VERZE (jen číslo verze - samotné vyhledávání aktualizací je níž) -->
                <Label x:Name="AppVersionLabel" FontSize="11" TextColor="Gray" HorizontalOptions="Center" Margin="0,20,0,4"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>