<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:MobilniKucharka.Services"
             xmlns:bookmarks="clr-namespace:MobilniKucharka.Classes.UserData.Bookmark"
             xmlns:loc="clr-namespace:MobilniKucharka.Translation"
             x:Class="MobilniKucharka.Classes.UserData.Bookmark.BookmarkCategoryPage">

    <ContentPage.Resources>
        <loc:TrTemplateConverter x:Key="TrTemplateConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">

        <!-- HLAVIČKA ZÁLOŽKY: název + volitelný popis (Bookmark.Description) - zobrazeno navíc
             k nav-bar Title, protože Title samotný nemá prostor pro víceřádkový popis. -->
        <VerticalStackLayout Grid.Row="0" Padding="20,15,20,10" Spacing="4">
            <Label x:Name="CategoryNameLabel" FontSize="22" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
            <Label x:Name="CategoryDescriptionLabel" FontSize="13" IsVisible="False"
                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" x:Name="RecipesCollectionView">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:RecipeWithCost">
                    <Border Margin="15,5,15,10" Padding="0" StrokeShape="RoundRectangle 12" Stroke="LightGray" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRecipeTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="120, *" RowDefinitions="Auto, *, Auto">
                            <Image Source="{Binding Recipe.ImageUrl}" Aspect="AspectFill" Grid.RowSpan="3" Grid.Column="0" />
                            <Label Text="{Binding Recipe.Name}" Grid.Column="1" Grid.Row="0" 
                                   FontAttributes="Bold" FontSize="18" Margin="10,10,10,0" LineBreakMode="TailTruncation" MaxLines="2" />
                            <Label Text="{Binding Recipe.PrepTime, Converter={StaticResource TrTemplateConverter}, ConverterParameter='Čas: {0} min'}" 
                                   Grid.Column="1" Grid.Row="1" FontSize="12" TextColor="Gray" Margin="10,5,10,0"
                                   IsVisible="{Binding Recipe.HasPrepTime}" />
                            <VerticalStackLayout Grid.Column="1" Grid.Row="2" Margin="10,10,10,10" Spacing="2">
                                <Label Text="{Binding CostDisplayText}" 
                                       TextColor="{Binding CostColor}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding BudgetStatusText}" 
                                       TextColor="{Binding CostColor}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="🍲" FontSize="50" HorizontalOptions="Center" />
                    <Label Text="{loc:Tr 'V této záložce nejsou žádné recepty.'}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Gray"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>