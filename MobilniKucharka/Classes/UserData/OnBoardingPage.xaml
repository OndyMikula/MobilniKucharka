<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobilniKucharka.Classes.UserData.OnboardingPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <Grid>
        <Grid RowDefinitions="Auto, *, Auto" Padding="20">

            <!-- HLAVIČKA -->
            <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,10,0,20">
                <Label x:Name="StepTitle" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                <Label x:Name="StepDescription" FontSize="14" TextColor="Gray" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <ProgressBar x:Name="WizardProgress" Progress="0.33" ProgressColor="#4CAF50" HeightRequest="4" Margin="0,10,0,0"/>
            </VerticalStackLayout>

            <!-- KROK: JAZYK (jen při prvním spuštění aplikace) -->
            <VerticalStackLayout x:Name="Step_Language" Grid.Row="1" Spacing="15" IsVisible="False" VerticalOptions="Center">
                <Button x:Name="LanguageCzechButton" Text="Čeština" Clicked="OnLanguageCzechClicked"
                        BackgroundColor="#2196F3" TextColor="White" CornerRadius="10" HeightRequest="55" FontAttributes="Bold"/>
                <Button x:Name="LanguageEnglishButton" Text="English" Clicked="OnLanguageEnglishClicked"
                        BackgroundColor="Transparent" TextColor="#2196F3" CornerRadius="10" HeightRequest="55" FontAttributes="Bold"
                        BorderColor="#2196F3" BorderWidth="1"/>
            </VerticalStackLayout>

            <!-- KROK: VOLBA ZÁLOHY (jen při prvním spuštění aplikace, ne při úpravě přes Settings) -->
            <VerticalStackLayout x:Name="Step_Backup" Grid.Row="1" Spacing="20" IsVisible="False" VerticalOptions="Center">
                <Label Text="👋" FontSize="50" HorizontalOptions="Center" />
                <Button x:Name="ContinueWithoutBackupButton" Clicked="OnContinueWithoutBackupClicked"
                        BackgroundColor="#2196F3" TextColor="White" CornerRadius="10" HeightRequest="55" FontAttributes="Bold"/>
                <Button x:Name="LoadBackupButton" Clicked="OnLoadBackupFromOnboardingClicked"
                        BackgroundColor="#607D8B" TextColor="White" CornerRadius="10" HeightRequest="55" FontAttributes="Bold"/>
            </VerticalStackLayout>

            <!-- KROK: Lidé a Budget -->
            <VerticalStackLayout x:Name="Step_Budget" Grid.Row="1" Spacing="20" IsVisible="False">

                <Border Stroke="LightGray" StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="Transparent">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="PeopleQuestionLabel" FontAttributes="Bold" FontSize="16"/>
                        <Stepper x:Name="PeopleStepper" Minimum="1" Maximum="10" Increment="1" Value="2" ValueChanged="OnPeopleChanged"/>
                        <Label x:Name="PeopleLabel" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#2196F3"/>
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="LightGray" StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="Transparent">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="BudgetQuestionLabel" FontAttributes="Bold" FontSize="16"/>
                        <Slider x:Name="BudgetSlider" Minimum="500" Maximum="10000" Value="2000" ValueChanged="OnBudgetChanged"/>
                        <Label x:Name="BudgetLabel" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#4CAF50" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- KROK: Dietní potřeby -->
            <VerticalStackLayout x:Name="Step_Diets" Grid.Row="1" Spacing="15" IsVisible="False">
                <Label x:Name="DietsQuestionLabel" FontAttributes="Bold" FontSize="16" Margin="0,0,0,10"/>
                <HorizontalStackLayout Spacing="15">
                    <CheckBox x:Name="CheckVegetarian" />
                    <Label x:Name="VegetarianLabel" VerticalOptions="Center" FontSize="16"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="15">
                    <CheckBox x:Name="CheckVegan" />
                    <Label x:Name="VeganLabel" VerticalOptions="Center" FontSize="16"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="15">
                    <CheckBox x:Name="CheckLactose" />
                    <Label x:Name="LactoseLabel" VerticalOptions="Center" FontSize="16"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- KROK: Spotřebiče -->
            <VerticalStackLayout x:Name="Step_Appliances" Grid.Row="1" Spacing="15" IsVisible="False">
                <Label x:Name="AppliancesQuestionLabel" FontAttributes="Bold" FontSize="16" Margin="0,0,0,10"/>
                <HorizontalStackLayout Spacing="15">
                    <CheckBox x:Name="CheckOven" IsChecked="True"/>
                    <Label x:Name="OvenLabel" VerticalOptions="Center" FontSize="16"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="15">
                    <CheckBox x:Name="CheckStove" IsChecked="True"/>
                    <Label x:Name="StoveLabel" VerticalOptions="Center" FontSize="16"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="15">
                    <CheckBox x:Name="CheckKettle" IsChecked="True"/>
                    <Label x:Name="KettleLabel" VerticalOptions="Center" FontSize="16"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="15">
                    <CheckBox x:Name="CheckMicrowave" IsChecked="True"/>
                    <Label x:Name="MicrowaveLabel" VerticalOptions="Center" FontSize="16"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- SPODNÍ NAVIGACE -->
            <Grid x:Name="BottomNavGrid" Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="15" Padding="0,15,0,10">
                <Button x:Name="BackButton" Clicked="OnBackClicked" IsVisible="False"
                        BackgroundColor="#9E9E9E" TextColor="White" CornerRadius="10" HeightRequest="55"
                        FontSize="14" LineBreakMode="WordWrap" Padding="6,4"/>

                <Button x:Name="NextButton" Grid.Column="1" Clicked="OnNextClicked" 
                        BackgroundColor="#2196F3" TextColor="White" CornerRadius="10" HeightRequest="55"
                        FontSize="14" LineBreakMode="WordWrap" Padding="6,4"/>
            </Grid>
        </Grid>

        <!-- OVERLAY: NAČÍTÁNÍ ZÁLOHY -->
        <Grid x:Name="BackupProgressOverlay" IsVisible="False" BackgroundColor="#99000000">
            <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="280" Padding="25" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" StrokeShape="RoundRectangle 15">
                <VerticalStackLayout Spacing="15">
                    <Label x:Name="BackupProgressLabel" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <ProgressBar x:Name="BackupProgressBar" Progress="0" ProgressColor="#2196F3"/>
                    <Label x:Name="BackupProgressPercentLabel" Text="0 %" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>