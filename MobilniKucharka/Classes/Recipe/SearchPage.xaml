<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:MobilniKucharka.Services"
             xmlns:loc="clr-namespace:MobilniKucharka.Translation"
             xmlns:navigation="clr-namespace:MobilniKucharka.Classes.Navigation"
             x:Class="MobilniKucharka.Classes.Recipe.SearchPage"
             Title="{loc:Tr 'Hledat recept'}"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid x:Name="SearchBarGrid" Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="15,15,15,10" ColumnSpacing="8">
            <Entry Grid.Column="0" x:Name="SearchEntry"
                   Placeholder="{loc:Tr 'Hledat recept podle názvu...'}"
                   Completed="OnSearchButtonClicked"
                   VerticalOptions="Center" />
            <Button Grid.Column="1" Text="🔍" FontSize="18"
                    WidthRequest="44" HeightRequest="44" Padding="0" CornerRadius="22"
                    BackgroundColor="#2196F3" TextColor="White" Clicked="OnSearchButtonClicked" />
            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                <CheckBox x:Name="FilterByPreferencesCheckBox" HorizontalOptions="Center" />
                <Label Text="{loc:Tr 'Dle preferencí'}" FontSize="9" TextColor="Gray" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1">
            <CollectionView x:Name="ResultsCollectionView" Margin="15,0,15,15" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:ExternalRecipeSearchResult">
                        <Border Margin="0,5,0,10" Padding="0" StrokeShape="RoundRectangle 12" Stroke="LightGray" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Grid ColumnDefinitions="90, *" RowDefinitions="Auto, Auto">
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" Grid.RowSpan="2" Grid.Column="0" />
                                <Label Text="{Binding Name}" Grid.Column="1" Grid.Row="0"
                                       FontAttributes="Bold" FontSize="16" Margin="10,10,10,5" LineBreakMode="TailTruncation" MaxLines="2" />
                                <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="*, Auto, Auto" Margin="10,0,10,10" ColumnSpacing="8">
                                    <Button Grid.Column="1" Text="{loc:Tr 'Detail'}" Clicked="OnResultDetailClicked" CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent" TextColor="#2196F3" FontSize="13" Padding="10,0" />
                                    <Button Grid.Column="2" Text="{loc:Tr 'Importovat'}" Clicked="OnResultImportClicked" CommandParameter="{Binding .}"
                                            BackgroundColor="#4CAF50" TextColor="White" FontSize="13" CornerRadius="8" Padding="10,0" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="30,60,30,0">
                        <Label Text="🔎" FontSize="50" HorizontalOptions="Center" />
                        <Label Text="{loc:Tr 'Zadej název receptu a vyhledej ho na internetu.'}" FontSize="14" TextColor="Gray" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- OVERLAY: NAČÍTÁNÍ -->
            <Grid x:Name="LoadingOverlay" IsVisible="False" BackgroundColor="#99000000">
                <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="240" Padding="25" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" StrokeShape="RoundRectangle 15">
                    <VerticalStackLayout Spacing="15">
                        <ActivityIndicator IsRunning="True" Color="#2196F3" />
                        <Label Text="{loc:Tr 'Hledám recepty...'}" HorizontalOptions="Center" FontAttributes="Bold" />
                        <Button Text="{loc:Tr 'Zrušit'}" Clicked="OnCancelSearchClicked" BackgroundColor="Gray" TextColor="White" CornerRadius="8" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <navigation:BottomNavBar Grid.Row="2" x:Name="BottomNav" TabRequested="OnBottomNavTabRequested" />

    </Grid>
</ContentPage>