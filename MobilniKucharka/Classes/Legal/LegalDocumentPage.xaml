<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:legal="clr-namespace:MobilniKucharka.Classes.Legal"
             x:Class="MobilniKucharka.Classes.Legal.LegalDocumentPage"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout x:Name="SectionsLayout" Padding="20" Spacing="20">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="legal:LegalSection">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Heading}" FontAttributes="Bold" FontSize="17"
                               TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                        <Label Text="{Binding Body}" FontSize="14" LineHeight="1.3"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>